# JARVIS Environment Configuration

# Required
GROQ_API_KEY=your_groq_api_key_here

# Deployment
JARVIS_DEPLOYMENT_URL=
JARVIS_FRONTEND_DIR=
# Direct link to the packaged Windows installer zip (optional)
JARVIS_WINDOWS_DOWNLOAD_URL=
JARVIS_DEBUG=false

# LLM
JARVIS_LLM_MODEL=
JARVIS_LLM_FAST_MODEL=

# LiveKit
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Auth
JARVIS_REQUIRE_AUTH=false
JARVIS_JWT_SECRET=
JARVIS_JWT_EXPIRY_HOURS=0
JARVIS_ADMIN_USER=
JARVIS_ADMIN_PASS=

# Rate Limiting
JARVIS_RATE_LIMIT_RPS=0
JARVIS_RATE_LIMIT_BURST=0
JARVIS_STRICT_RATE_LIMIT_RPS=0
JARVIS_STRICT_RATE_LIMIT_BURST=0

# CORS
JARVIS_ALLOWED_ORIGINS=
JARVIS_ALLOWED_DOMAINS=

# Relay
JARVIS_RELAY_EXPIRY=120
JARVIS_RELAY_HEARTBEAT_TIMEOUT=60

# Network / Paths
# Override local subnet detection (e.g., 192.168.0). Leave empty for auto-detect.
JARVIS_LOCAL_SUBNET=
# Default screenshot path. Leave empty for system temp dir.
JARVIS_SCREENSHOT_PATH=
# Path to Tesseract OCR binary (overrides auto-detection).
TESSERACT_CMD=

# Smart Home
TAPO_USERNAME=
TAPO_PASSWORD=
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# External APIs
AMADEUS_API_KEY=
STRIPE_SECRET_KEY=
SKYSCANNER_API_KEY=
NAMECHEAP_API_USER=
