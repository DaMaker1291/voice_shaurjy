{
  "name": "jarvis-ai",
  "version": "5.0.0",
  "description": "JARVIS — Ambient Operating Layer. Autonomous AI ecosystem orchestrator combining WhatsApp-level distribution, Perplexity-level search, and OS-level execution.",
  "author": "JARVIS AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DaMaker1291/voice_shaurjy.git"
  },
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development electron .",
    "build": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux --x64",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.jarvis.ambient",
    "productName": "JARVIS",
    "copyright": "Copyright © 2026 JARVIS AI",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "description": "JARVIS — Ambient Operating Layer. An autonomous AI ecosystem orchestrator combining WhatsApp-level distribution, Perplexity-level search, and OS-level execution."
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*.py",
          "!__pycache__/**",
          "!*.pyc"
        ]
      },
      {
        "from": "../frontend/out",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JARVIS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/sidebar.bmp",
      "uninstallerSidebar": "assets/sidebar.bmp",
      "license": "LICENSE.txt"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "ws": "^8.21.2"
  }
}
