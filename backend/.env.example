# LiveKit — required for real-time voice
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret
LIVEKIT_TOKEN=your-livekit-token

# Voice Pipeline — WebSocket at /ws/voice
# STT: faster-whisper (auto-downloaded, ~150MB)
# TTS: Piper TTS (auto-downloaded, ~50MB)
# Falls back to edge-tts if local TTS unavailable

# MCP Gateway — WebSocket at /ws/mcp
# MCP servers are auto-discovered from:
#   - ~/.claude/claude_desktop_config.json
#   - .vscode/mcp.json
#   - ~/.jarvis/mcp.json
# No additional config needed — just install MCP servers

# Groq API — required for LLM (get your key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key-here

# ── Authentication ──────────────────────────────────────────────
# Set to 'true' in production to require auth on all endpoints
JARVIS_REQUIRE_AUTH=false

# Admin credentials for /api/auth/login
JARVIS_ADMIN_USER=admin
JARVIS_ADMIN_PASS=

# JWT secret (auto-generated if not set, but set for multi-instance deployments)
JARVIS_JWT_SECRET=
JARVIS_JWT_EXPIRY_HOURS=72

# API keys for machine-to-machine auth (relay agents, external services)
# Format: JARVIS_API_KEY_<NAME>=<secret-key>
JARVIS_API_KEY_RELAY=
JARVIS_API_KEY_AGENT=

# Master API key (grants admin scope)
JARVIS_API_KEY=

# ── Rate Limiting ───────────────────────────────────────────────
JARVIS_RATE_LIMIT_RPS=10
JARVIS_RATE_LIMIT_BURST=20
JARVIS_STRICT_RATE_LIMIT_RPS=2
JARVIS_STRICT_RATE_LIMIT_BURST=5

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (empty = allow all in dev)
JARVIS_ALLOWED_ORIGINS=
